{
  "name": "rupee-words",
  "version": "1.1.0",
  "type": "module",
  "description": "Zero-dependency, ultra-fast Indian Rupee & numbering system converter for GST invoices, cheques, and financial applications.",
  "author": "Vijay Misal <misalvijay153@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/vjymisal0/rupee-words#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vjymisal0/rupee-words.git"
  },
  "bugs": {
    "url": "https://github.com/vjymisal0/rupee-words/issues"
  },
  "keywords": [
    "rupee",
    "rupee-words",
    "indian-currency",
    "lakhs",
    "crores",
    "invoicing",
    "gst-invoice",
    "fintech-india",
    "number-to-words"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3",
    "@types/node": "^26.6.4"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
